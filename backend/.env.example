# ============================================================
# PRIME System — Backend Environment Variables Template
# ============================================================

# ------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------
# Port for the Node.js Express server.
# When deployed on Render or Railway, PORT is assigned automatically by the platform.
PORT=3000

# JSON Web Token secret key for authentication (use a long, random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Node environment: 'development' or 'production'
NODE_ENV=development

# ------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes).
# For local development:
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
# For production:
# CORS_ORIGIN=https://prime-system-phi.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ------------------------------------------------------------
# 3. MySQL Database Configuration
# ------------------------------------------------------------
# --- A. Local Development (XAMPP defaults) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=prime_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SSL=false

# --- B. Cloud Database (e.g. Aiven, TiDB Cloud, Railway, PlanetScale) ---
# Uncomment and fill in when deploying backend to cloud:
# MYSQL_HOST=mysql-xxxxx.aivencloud.com
# MYSQL_PORT=12345
# MYSQL_DATABASE=defaultdb
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_cloud_password
# MYSQL_SSL=true
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Alternatively, provide a single connection URI:
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxxx.aivencloud.com:12345/defaultdb

# ------------------------------------------------------------
# 4. Firebase Admin SDK (Optional — Realtime Sensor Monitoring)
# ------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ------------------------------------------------------------
# 5. Device Heartbeat Monitoring
# ------------------------------------------------------------
# How long without heartbeat before marking device offline (milliseconds, 300000 = 5 min)
DEVICE_OFFLINE_TIMEOUT_MS=300000
# How often to check for timeouts (milliseconds, 60000 = 1 min)
DEVICE_CHECK_INTERVAL_MS=60000
