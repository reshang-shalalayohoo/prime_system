PORT=3000
JWT_SECRET=prime_system_jwt_secret_change_in_production_2024
CORS_ORIGIN=http://localhost:5173

# MySQL (XAMPP)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=prime_db
MYSQL_USER=root
MYSQL_PASSWORD=

# Firebase Admin SDK (optional — sensor connection monitoring)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Device heartbeat timeout in milliseconds (default: 300000 = 5 minutes)
DEVICE_OFFLINE_TIMEOUT_MS=300000
# How often to check for device timeouts in milliseconds (default: 60000 = 1 minute)
DEVICE_CHECK_INTERVAL_MS=60000
